# Variables de entorno de AXIS Vision. Copia lo que falte a `apps/web/.env`.
# Este archivo NO lleva valores reales — solo los nombres y para qué sirven.

# ---------- Base de datos (RDS) ----------
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# POSTGRES_SSL=false   # solo para Postgres local / túnel sin SSL

# ---------- Sesión del panel ----------
JWT_SECRET_MANAGMENT=

# ---------- S3 / CloudFront ----------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PRODUCTS_BUCKET=
NEXT_PUBLIC_CDN_URL=

# ---------- Sitio ----------
# URL pública. Los correos y los redirect de Wompi solo aceptan URL absolutas.
NEXT_PUBLIC_SITE_URL=https://axisvision.co

# ---------- Modo de la tienda ----------
# 'live' = se puede comprar. Cualquier otra cosa (o sin definir) = solo reservar.
# Ver src/lib/storeMode.ts. Mantener en preview hasta que Wompi esté probado.
NEXT_PUBLIC_STORE_MODE=preview

# ---------- Wompi ----------
# Con NEXT_PUBLIC_STORE_MODE=live, además hacen falta las cuatro: si falta
# alguna, el servidor deja la tienda en modo reserva igualmente.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# ---------- Correo (Brevo) ----------
# Sin BREVO_API_KEY no se envía nada: las reservas se guardan igual y queda el
# rastro en el log. Ver src/server/email/README.md.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=pedidos@axisvision.co
BREVO_SENDER_NAME=AXIS Vision
BREVO_REPLY_TO=contacto@axisvision.co
ADMIN_NOTIFICATION_EMAIL=contacto@axisvision.co

# Remitente SEPARADO para los correos de lista (reservas). Muy recomendable:
# Brevo bloquea a un contacto POR REMITENTE, así que si alguien se da de baja de
# un aviso de reserva y comparte buzón con los pedidos, dejaría de recibir la
# confirmación de su propio pago. Si se deja vacío, se usa BREVO_SENDER_EMAIL.
BREVO_LIST_SENDER_EMAIL=avisos@axisvision.co

# Doble opt-in de la lista de espera. Apagado por defecto: con Brevo sin
# configurar dejaría a todo el mundo sin confirmar y la lista inservible.
# WAITLIST_DOUBLE_OPT_IN=true
